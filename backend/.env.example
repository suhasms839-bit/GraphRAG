# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Vector Store
VECTORSTORE_PERSIST_DIRECTORY="./chroma_db"
UPLOADS_DIR="./uploads"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""

# Database
DATABASE_URL="sqlite:///./graphrag.db"

# Optional MCP (Gmail MCP) configuration
# Enable the MCP integration and provide the command to run. Example calls npx:
GMAIL_MCP_ENABLED=false
GMAIL_MCP_COMMAND=npx
GMAIL_MCP_ARGS=-y,@shinzolabs/gmail-mcp
GMAIL_MCP_TIMEOUT=60

# Google OAuth2 client credentials (optional)
# Either set client id/secret directly, or place the downloaded JSON and set the path.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CREDENTIALS_PATH=./client_secret_<your>.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/
