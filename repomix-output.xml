    # Print summary
    avg_context_recall = df["context_recall"].mean()
    avg_context_precision = df["context_precision"].mean()
    avg_answer_similarity = df["answer_similarity"].mean()
    avg_faithfulness = df["faithfulness_proxy"].mean()
